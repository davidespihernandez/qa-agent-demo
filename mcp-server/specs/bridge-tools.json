   "properties": {
    "currency": {
     "default": "USD",
     "description": "ISO 4217 currency code",
     "example": "USD",
     "maxLength": 3,
     "minLength": 3,
     "type": "string"
    },
    "customerId": {
     "description": "Customer placing the order",
     "example": "usr-002",
