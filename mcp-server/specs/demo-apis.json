  "components": {
    "schemas": {
      "OpenApiDocument": {
        "type": "object",
        "description": "OpenAPI 3.0 document",
        "required": [
          "openapi",
          "info",
          "paths"
        ],
        "properties": {
          "openapi": {
            "type": "string",
            "example": "3.0.3"
          },
          "info": {
            "type": "object",
            "required": [
              "title",
              "version"
            ],
            "properties": {
              "title": {
                "type": "string",
                "example": "Orders API"
              },
              "version": {
                "type": "string",
                "example": "1.0.0"
              },
              "description": {
                "type": "string"
              }
            }
          },
          "servers": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "url": {
                  "type": "string",
                  "format": "uri"
                },
                "description": {
                  "type": "string"
                }
              }
            }
          },
          "paths": {
            "type": "object",
            "additionalProperties": true
          },
          "components": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "OrdersHealthResponse": {
        "type": "object",
        "required": [
          "status",
          "service",
          "version"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ],
            "example": "ok"
          },
          "service": {
            "type": "string",
            "example": "orders-api"
          },
          "version": {
            "type": "string",
            "example": "1.0.0"
          }
        }
      },
      "Order": {
        "type": "object",
        "required": [
          "id",
          "customerId",
          "status",
          "total",
          "currency"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique order identifier",
            "example": "ord-001"
          },
          "customerId": {
            "type": "string",
            "description": "ID of the customer who placed the order",
            "example": "usr-001"
          },
          "status": {
            "type": "string",
            "description": "Order lifecycle status",
            "enum": [
              "pending",
              "processing",
              "shipped",
              "cancelled"
            ],
            "example": "pending"
          },
          "total": {
            "type": "number",
            "format": "double",
            "minimum": 0,
            "description": "Order total amount",
            "example": 49.99
          },
          "currency": {
            "type": "string",
            "description": "ISO 4217 currency code",
            "minLength": 3,
            "maxLength": 3,
            "example": "USD"
          }
        }
      },
      "OrderListResponse": {
        "type": "object",
        "required": [
          "data",
          "count"
        ],
        "properties": {
          "data": {
            "type": "array",
            "description": "Orders in this page",
            "items": {
              "$ref": "#/components/schemas/Order"
            }
          },
          "count": {
            "type": "integer",
            "minimum": 0,
            "description": "Number of orders returned",
            "example": 2
          }
        }
      },
      "CreateOrderRequest": {
        "type": "object",
        "required": [
          "customerId",
          "total"
        ],
        "properties": {
          "customerId": {
            "type": "string",
            "description": "Customer placing the order",
            "example": "usr-002"
          },
          "total": {
            "type": "number",
            "format": "double",
            "minimum": 0,
            "example": 99.5
          },
          "status": {
            "type": "string",
            "description": "Initial order status",
            "enum": [
              "pending",
              "processing",
              "shipped",
              "cancelled"
            ],
            "default": "pending",
            "example": "pending"
          },
          "currency": {
            "type": "string",
            "description": "ISO 4217 currency code",
            "minLength": 3,
            "maxLength": 3,
            "default": "USD",
            "example": "USD"
          }
