{
  "openapi": "3.0.3",
  "info": {
    "title": "Demo APIs (Orders, Users, Payments)",
    "version": "1.0.0",
    "description": "Orders, Users and Payments APIs of the postman-api-catalog-demo, merged into one spec so a single Fabric service and MCP route cover all three."
  },
  "servers": [
    {
      "url": "https://18-157-170-15.nip.io",
      "description": "Deployed worker"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "System"
        ],
        "operationId": "getHealth",
        "summary": "Health check",
        "responses": {
          "200": {
            "description": "Service is healthy",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrdersHealthResponse"
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/OrdersInternalServerError"
          }
        }
      }
    },
    "/openapi.json": {
      "get": {
        "tags": [
          "System"
        ],
        "operationId": "getOpenApi",
        "summary": "OpenAPI specification",
        "responses": {
          "200": {
            "description": "OpenAPI document",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpenApiDocument"
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/OrdersInternalServerError"
          }
        }
      }
    },
    "/orders": {
      "get": {
        "tags": [
          "Orders"
        ],
        "operationId": "listOrders",
        "summary": "List orders",
        "responses": {
          "200": {
            "description": "Paginated-style order list",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderListResponse"
                },
                "example": {
                  "data": [
                    {
                      "id": "ord-001",
                      "customerId": "usr-001",
                      "status": "shipped",
                      "total": 49.99,
                      "currency": "USD"
                    }
                  ],
                  "count": 1
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/OrdersInternalServerError"
          }
        }
      },
      "post": {
        "tags": [
          "Orders"
        ],
        "operationId": "createOrder",
        "summary": "Create order",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateOrderRequest"
              },
              "example": {
                "customerId": "usr-002",
                "total": 99.5,
                "status": "pending",
                "currency": "USD"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Order created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Order"
                },
                "example": {
                  "id": "ord-a1b2c3d4",
                  "customerId": "usr-002",
                  "status": "pending",
                  "total": 99.5,
                  "currency": "USD"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrdersErrorResponse"
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/OrdersInternalServerError"
          }
        }
      }
    },
    "/orders/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "description": "Order identifier",
          "schema": {
            "type": "string",
            "example": "ord-001"
          }
        }
      ],
      "get": {
        "tags": [
          "Orders"
        ],
        "operationId": "getOrder",
        "summary": "Get order by ID",
        "responses": {
          "200": {
            "description": "Order found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Order"
                },
                "example": {
                  "id": "ord-001",
                  "customerId": "usr-001",
                  "status": "shipped",
                  "total": 49.99,
                  "currency": "USD"
                }
              }
            }
          },
          "404": {
            "description": "Order not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrdersErrorResponse"
                },
                "example": {
                  "error": "Order not found"
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/OrdersInternalServerError"
          }
        }
      },
      "put": {
        "tags": [
          "Orders"
        ],
        "operationId": "updateOrder",
        "summary": "Replace order",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateOrderRequest"
              },
              "example": {
                "customerId": "usr-003",
                "total": 149.99,
                "status": "processing",
                "currency": "EUR"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Order updated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Order"
                },
                "example": {
                  "id": "ord-001",
                  "customerId": "usr-003",
                  "status": "processing",
                  "total": 149.99,
                  "currency": "EUR"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrdersErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Order not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrdersErrorResponse"
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/OrdersInternalServerError"
          }
        }
      },
      "patch": {
        "tags": [
          "Orders"
        ],
        "operationId": "patchOrder",
        "summary": "Partially update order",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PatchOrderRequest"
              },
              "example": {
                "status": "shipped"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Order patched",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Order"
                },
                "example": {
                  "id": "ord-001",
                  "customerId": "usr-003",
                  "status": "shipped",
                  "total": 149.99,
                  "currency": "EUR"
                }
              }
            }
          },
          "404": {
            "description": "Order not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrdersErrorResponse"
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/OrdersInternalServerError"
          }
        }
      },
      "delete": {
        "tags": [
          "Orders"
        ],
        "operationId": "deleteOrder",
        "summary": "Delete order",
        "responses": {
          "204": {
            "description": "Order deleted"
          },
          "404": {
            "description": "Order not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrdersErrorResponse"
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/OrdersInternalServerError"
          }
        }
      }
    },
