# Copy to .env and fill in. Never commit .env.
# Run harness commands from the repo root so bun loads this file.

# App under test (serve the built Orders frontend, e.g. `npx vite preview --port 4173`)
APP_URL=http://localhost:4173

# LLM
ANTHROPIC_API_KEY=
QA_MODEL=anthropic/claude-sonnet-4-5

# --- Arm A (direct): leave everything below empty. The browser tool runs locally over stdio. ---

# --- Arms B/C (through Fabric Gateway) ---
# Anthropic route of your Fabric gateway, e.g. https://<host>/anthropic  (the SDK appends /v1/messages)
LLM_BASE_URL=
# MCP route of your Fabric gateway (Playwright MCP behind it)
MCP_URL=
# Sent as "Authorization: Bearer" on both LLM and MCP calls
FABRIC_GATEWAY_KEY=

# Optional: hosted Playwright MCP reached directly (not through Fabric) with a bearer token
MCP_TOKEN=
