# Copy to .env and fill in. Never commit .env.
# Run harness commands from the repo root so bun loads this file.

# LLM
ANTHROPIC_API_KEY=
QA_MODEL=anthropic/claude-sonnet-4-5

# Business APIs (Orders, Users, Payments). Empty = use the servers URL in agent/agent/specs/demo-apis.json
API_BASE_URL=

# Fraud alerts: POST target (e.g. a Postman Flow webhook). Secret: it stays out of git.
# Leave EMPTY for benchmark runs (the tool then skips the POST). Only set it for live demos.
FRAUD_WEBHOOK_URL=

# --- Arm A (direct): leave everything below empty. API tools run in-process, read-only. ---

# --- Arms B/C (through Fabric Gateway) ---
# Anthropic route of your Fabric gateway, e.g. https://<host>/anthropic  (the SDK appends /v1/messages)
LLM_BASE_URL=
# MCP route of your Fabric gateway, e.g. https://<host>/mcp/demo-apis (the APIs exposed by the MCP HTTP bridge)
MCP_URL=
# Arm B-ro: a second MCP route whose bridge exposes only the 8 GET operations
MCP_URL_READONLY=
# Arm C: a third MCP route with the Tool Search plugin (blocked for now)
MCP_URL_SEARCH=
# Arm D: the same Anthropic route with the adaptive-model-router plugin, e.g. https://<host>/anthropic-adaptive
LLM_BASE_URL_ADAPTIVE=
# Arms F / F-eco (Fabric without the MCP bridge): the Orders API route and the economy LLM route, e.g. https://<host>/api and https://<host>/anthropic-economy
FABRIC_API_URL=
LLM_BASE_URL_ECONOMY=
# Sent as "Authorization: Bearer" on the LLM route and as "fg-api-key" on the MCP route
FABRIC_GATEWAY_KEY=

# Header names for the gateway key. Defaults match the beta tenant. Production docs use X-Gateway-Key for everything:
#   FABRIC_KEY_HEADER=X-Gateway-Key        (HTTP and MCP routes; default fg-api-key)
#   FABRIC_LLM_KEY_HEADER=X-Gateway-Key    (LLM route; default is Authorization: Bearer)
FABRIC_KEY_HEADER=
FABRIC_LLM_KEY_HEADER=

# Optional: an MCP server reached directly (not through Fabric) with a bearer token
MCP_TOKEN=

# Optional: require this in the x-demo-key header of POST /review (agent/agent/server.ts)
DEMO_API_KEY=
