# Copy to .env and fill in. Never commit .env.

# App under test
APP_URL=http://localhost:4173

# LLM: set to the provider URL for arm A, or your Fabric gateway URL for arms B/C
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com

# Browser tool (Playwright MCP): direct URL for arm A, Fabric MCP route for arms B/C
PLAYWRIGHT_MCP_URL=
PLAYWRIGHT_MCP_TOKEN=

# Fabric Gateway (arms B/C)
FABRIC_GATEWAY_KEY=
